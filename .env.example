# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Supabase (Project Settings -> API). Service-role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM=Scoper <onboarding@resend.dev>
LEAD_NOTIFY_EMAIL=

# Public base URL, used in emails and the PDF
APP_URL=http://localhost:3000

# Set to 1 to skip Groq and return a fixture scope (e2e tests, offline dev)
SCOPER_FAKE_LLM=0
