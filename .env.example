# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Model chain, tried in order; a rate-limited or failing model hands over to the next.
# Leave empty for the default: openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
GROQ_MODELS=

# Supabase (Project Settings -> API Keys). The secret key is server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Publishable key: only used by the integration tests, to prove the public API cannot read our tables.
SUPABASE_PUBLISHABLE_KEY=
# Random string; IPs are stored only as salted hashes for rate limiting.
IP_HASH_SALT=

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM="Scoper <onboarding@resend.dev>"
LEAD_NOTIFY_EMAIL=

# Public base URL, used in emails and the PDF
APP_URL=http://localhost:3000

# Set to 1 to skip Groq and return a fixture scope (e2e tests, offline dev)
SCOPER_FAKE_LLM=0

# Scope requests allowed per visitor (hashed IP) per hour
SCOPE_LIMIT_PER_HOUR=5
